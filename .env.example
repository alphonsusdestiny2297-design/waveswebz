# ==============================================================================
# Waves Environment Configuration Example
# ==============================================================================
# Set values here for local tooling, and in your hosting dashboard
# (Vercel: Project Settings → Environment Variables) for deployments.
#
# NOTE: GEMINI_API_KEY is read ONLY by the serverless function api/chat.ts
# on the server. It is never compiled into the public JavaScript bundle.
# If it is not set, the AI concierge answers with the built-in deterministic
# guardrail responses (pricing, guarantees, WhatsApp, service levels),
# so the chat always works even without a key.
# ==============================================================================

# Google Gemini API Key (Optional — server-side only, used by /api/chat)
GEMINI_API_KEY=
